# instance/test.env — settings and credentials for the E2E harnesses
#
# Loaded by all three harnesses:
#   - instance/scripts/*.py            via instance/scripts/utils/testenv.py
#   - instance/interactive-tests/*     via playwright.config.ts
#
# Real process environment WINS over this file, so CI can override any value
# without editing it. That direction is deliberate: a checked-in file that
# silently overrode CI's own configuration would be worse than no file.
#
# ── What does NOT belong here ────────────────────────────────────────────────
# No real secrets. Every value below is dummy, local-only, and greppable.
# Provider API keys (NVIDIA, OpenRouter, Google OAuth) stay in Backend/.env.local
# and are read by the server, never by a harness. If you find yourself pasting a
# real key here, put it in Backend/.env.local instead.

# ── Where the app is ─────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000

# ── Test-client rate lane ────────────────────────────────────────────────────
# Presented as the `X-E2E-Bypass-Token` header so the backend applies the
# test-client rate lane instead of the human one (Backend/core/http/throttling.py).
# Exempts RATE LIMITS ONLY — authentication, permissions and ownership are
# untouched. Must match E2E_THROTTLE_BYPASS_TOKEN in Backend/.env.local.
# The whole mechanism is off wherever that setting is blank, which is the
# default and what any real deployment should keep.
E2E_THROTTLE_BYPASS_TOKEN=instance-local-e2e

# ── Personas ─────────────────────────────────────────────────────────────────
# Created by `python instance/scripts/seed_instance.py`. Passwords are dummy and
# only ever valid against a local, seeded database.
#
# regular_user is the primary demo persona — the one the recorded walkthrough
# and the happy-path scenarios drive. power_user exists so ownership boundaries
# have a second party to be tested against (user A must not reach user B's
# rows); viewer is the low-privilege persona.
E2E_REGULAR_EMAIL=regular_user@example.com
E2E_REGULAR_PASSWORD=Regular123!
E2E_POWER_EMAIL=power_user@example.com
E2E_POWER_PASSWORD=Power123!
E2E_VIEWER_EMAIL=viewer@example.com
E2E_VIEWER_PASSWORD=Viewer123!

# ── Model used by seeded demo agents ─────────────────────────────────────────
# Served through NVIDIA on the platform key, so no per-user credential is needed.
#
# Deliberately NOT the platform default `nvidia/nemotron-3-super-120b-a12b`:
# measured 2026-09-01, that model answered roughly half of all requests with an
# in-band `{"error": {"code": 503, "message": "Service temporarily overloaded"}}`
# frame inside an HTTP 200 SSE body (2/4 succeeded, against 4/4 for the two
# below). A demo must not roll a coin in front of a stakeholder.
E2E_DEMO_PROVIDER=nvidia
E2E_DEMO_MODEL=openai/gpt-oss-20b
E2E_DEMO_MODEL_SMALL=openai/gpt-oss-20b

# ── Timeouts (milliseconds unless named _S) ──────────────────────────────────
# A model call over a real provider is the slow part; these are sized for that,
# not for a local stub.
E2E_ACTION_TIMEOUT=10000
E2E_EXPECT_TIMEOUT=8000
E2E_TEST_TIMEOUT=45000
E2E_RUN_TIMEOUT_S=60

# ── Recording ────────────────────────────────────────────────────────────────
# Used by the recorded walkthrough (scenarios/008-normal-user-day.spec.ts).
# E2E_RECORD=1 forces video + a slower, human-paced cadence so the result is
# watchable; leave it unset for ordinary fast test runs.
E2E_RECORD=
E2E_TYPING_DELAY_MS=45
E2E_BEAT_MS=900
E2E_VIDEO_WIDTH=1280
E2E_VIDEO_HEIGHT=720

# ─────────────────────────────────────────────────────────────────────────────
# Backend settings for a test run
# ─────────────────────────────────────────────────────────────────────────────
# Moved here from Backend/.env.local so the test configuration lives in one
# file. `workflow_backend/settings/local.py` loads this file *after* .env.local
# and does NOT override — anything you set in .env.local still wins, so a
# developer's local tweak is never clobbered by this shared file.
#
# Secrets deliberately did NOT move. SECRET_KEY, CREDENTIAL_ENCRYPTION_KEY,
# GOOGLE_OAUTH_CLIENT_SECRET and the five provider API keys stay in
# Backend/.env.local, which is untracked. This file is tracked (instance/.gitignore
# has `!test.env`) precisely so the whole team shares one test setup — which is
# also exactly why a live key must never be pasted into it.

# Django
DEBUG=True

# Database — SQLite, resolved against Backend/ regardless of working directory
# (settings/base.py). A relative path used to resolve against the cwd, which
# silently gave manage.py and the harnesses two different database files.
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# No Redis locally: in-memory channel layer, synchronous execution. Async is a
# separate axis and turning it on changes what a run means, so the harnesses
# assume it is off.
USE_REDIS_CHANNEL_LAYER=False
RUN_WORKFLOWS_ASYNC=False

# Hosts / CORS — the frontend and the harnesses both talk to localhost.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
PUBLIC_URL=http://localhost:8000

# Google OAuth — the client *id* is public (it ships in the redirect URL the
# user's browser follows). The secret stays in Backend/.env.local.
GOOGLE_OAUTH_CLIENT_ID=860732387709-kurtttd0m4nc40mjfvngqh0cklat7odv.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Model served to unauthenticated guest chat.
NVIDIA_GUEST_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Email — console backend, so a test run that triggers the HITL digest prints it
# instead of sending it. Never point a test run at a real SMTP host.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
NOTIFICATIONS_EMAIL_ENABLED=True
NOTIFICATIONS_EMAIL_SUBJECT_PREFIX=[AIAAS]
