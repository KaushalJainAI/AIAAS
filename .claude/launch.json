{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "Backend/manage.py",
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "port": 8000
    },
    {
      "name": "backend-venv",
      "runtimeExecutable": "Backend/venv/Scripts/python.exe",
      "runtimeArgs": [
        "Backend/manage.py",
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "better-n8n-frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}