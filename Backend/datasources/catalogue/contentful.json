{
  "openapi": "3.0.3",
  "info": {
    "title": "Contentful Content Delivery API (read-only subset)",
    "version": "1",
    "description": "GET operations from the Contentful Content Delivery API. Base URL: https://cdn.contentful.com/spaces/{space_id}"
  },
  "paths": {
    "/entries": {
      "get": {
        "summary": "Get all published entries in the space",
        "x-aiaas-check": true,
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 1000}},
          {"name": "skip", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
          {"name": "content_type", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "A page of entries"}}
      }
    },
    "/entries/{entry_id}": {
      "get": {
        "summary": "Get one entry",
        "parameters": [
          {"name": "entry_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "One entry"}}
      }
    },
    "/assets": {
      "get": {
        "summary": "Get all assets in the space",
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 1000}},
          {"name": "skip", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}}
        ],
        "responses": {"200": {"description": "A page of assets"}}
      }
    },
    "/assets/{asset_id}": {
      "get": {
        "summary": "Get one asset",
        "parameters": [
          {"name": "asset_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "One asset"}}
      }
    },
    "/content_types": {
      "get": {
        "summary": "Get the content model of the space",
        "responses": {"200": {"description": "The content types and their fields"}}
      }
    }
  }
}
