# Copy to Backend/.env.local (local dev) or Backend/.env (docker) and fill in.
# Never commit the filled-in copy.

# ── Core ─────────────────────────────────────────────────────────────
SECRET_KEY=                        # any long random string
DEBUG=True
CREDENTIAL_ENCRYPTION_KEY=         # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Database (SQLite locally, Postgres in production) ────────────────
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
DATABASE_URL=                      # postgres DSN; overrides DB_* when set

# ── Channels / Celery ────────────────────────────────────────────────
USE_REDIS_CHANNEL_LAYER=False
REDIS_URL=redis://localhost:6379/0
RUN_WORKFLOWS_ASYNC=False

# ── Hosts / CORS ─────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:5173
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# ── LLM providers ────────────────────────────────────────────────────
OPENROUTER_API_KEY=                # required: platform key for the default model
DECISION_PROVIDER=openrouter       # decide tool: platform default provider (users pick their own in Settings)
DECISION_MODEL=~typesafe/jev-latest  # decide tool: platform default decision model
NVIDIA_API_KEY=                    # optional: context-summary model + vision witness
TAVILY_API_KEY=                    # optional: web search

# ── Google OAuth (sign-in + Gmail/Drive/Sheets/Calendar connectors) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# ── Email (the daily HITL digest only) ───────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
NOTIFICATIONS_EMAIL_ENABLED=False

# ── Web Push (optional; python manage.py generate_vapid_keys) ────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@aiaas.local

# ── Outbound send window (docs/UNDO_PLAN.md §5) ──────────────────────
# Seconds a send waits while a person is watching, so they can cancel it. 0 = send at once.
OUTBOUND_HOLD_SECONDS=20
# How often the sweep looks for held sends whose timer was lost.
OUTBOUND_HOLD_SWEEP_SECONDS=15

# ── Undo: change sets (docs/UNDO_PLAN.md §6) ─────────────────────────
# Days a change set (what a chat answer or run changed) is kept for undo.
# Blank = RECYCLE_BIN_RETENTION_DAYS: past that a trashed file cannot come back.
# CHANGE_HISTORY_DAYS=30
# How often old change sets are purged.
CHANGE_SET_SWEEP_SECONDS=86400
