# Copy to Backend/.env.local (local dev) or Backend/.env (docker) and fill in.
# Never commit the filled-in copy.

# ── Core ─────────────────────────────────────────────────────────────
SECRET_KEY=                        # any long random string
DEBUG=True
CREDENTIAL_ENCRYPTION_KEY=         # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Database (SQLite locally, Postgres in production) ────────────────
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
DATABASE_URL=                      # postgres DSN; overrides DB_* when set

# ── Channels / Celery ────────────────────────────────────────────────
USE_REDIS_CHANNEL_LAYER=False
REDIS_URL=redis://localhost:6379/0
RUN_WORKFLOWS_ASYNC=False

# ── Hosts / CORS ─────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:5173
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# ── LLM providers ────────────────────────────────────────────────────
OPENROUTER_API_KEY=                # required: platform key for the default model
NVIDIA_API_KEY=                    # optional: context-summary model + vision witness
TAVILY_API_KEY=                    # optional: web search

# ── Google OAuth (sign-in + Gmail/Drive/Sheets/Calendar connectors) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# ── Email (the daily HITL digest only) ───────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
NOTIFICATIONS_EMAIL_ENABLED=False

# ── Web Push (optional; python manage.py generate_vapid_keys) ────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@aiaas.local
